#usda 1.0
(
    defaultPrim = "native"
    doc = "Forgery override_lost on piece pallet: de-instancing lost: the lone case lime inside its orange outline. This is what a viewer with that bug shows; the correct exhibit is ../native.usda. Generated by usd-tour museum/src/export.py (usd-tour 1d60c79); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../native.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "native"
{
    over "Pallet"
    {
        over "Cart3"
        {
            over "StackR"
            {
                over "High" (
                    instanceable = false
                )
                {
                    float primvars:displayColor = None
                }
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "names"
    doc = "Forgery primvar_unnamespaced on piece primvar: the primvar namespace dropped: a red bust on the cyan plinth. This is what a viewer with that bug shows; the correct exhibit is ../names.usda. Generated by usd-tour museum/src/export.py (usd-tour 1d60c79); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../names.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "names"
{
    over "Pieces"
    {
        over "Primvar"
        {
            over "Looks"
            {
                over "Painted"
                {
                    over "Reader"
                    {
                        string inputs:varname = "base"
                    }
                }
            }
        }
    }
}


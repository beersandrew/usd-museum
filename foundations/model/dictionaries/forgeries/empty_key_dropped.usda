#usda 1.0
(
    defaultPrim = "dictionaries"
    doc = "Forgery empty_key_dropped on piece empty key: a red vase on the violet base. This is what a viewer with that bug shows; the correct exhibit is ../dictionaries.usda. Generated by usd-tour museum/src/export.py (usd-tour 1c0b96b); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../dictionaries.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "dictionaries"
{
    over "Pieces"
    {
        over "Blank"
        {
            over "Vase" (
                variants = {
                    string glaze = "red"
                }
            )
            {
            }
        }
    }
}


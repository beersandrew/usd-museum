#usda 1.0
(
    defaultPrim = "metadata"
    doc = "Forgery typed_key_misread on piece typed keys: a grey ('off') vase on the green base. This is what a viewer with that bug shows; the correct exhibit is ../metadata.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../metadata.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "metadata"
{
    over "Pieces"
    {
        over "Typed"
        {
            over "Vase" (
                variants = {
                    string glaze = "off"
                }
            )
            {
            }
        }
    }
}


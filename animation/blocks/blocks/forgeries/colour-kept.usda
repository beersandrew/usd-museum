#usda 1.0
(
    defaultPrim = "blocks"
    doc = "Forgery colour-kept on piece colour: the colour block ignored: a red cart on the grey track. This is what a viewer with that bug shows; the correct exhibit is ../blocks.usda. Generated by usd-tour museum/src/export.py (usd-tour 62d7ecc); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../blocks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "blocks"
{
    over "Stands"
    {
        over "Blocks"
        {
            over "Pieces"
            {
                over "Colour"
                {
                    over "Ride"
                    {
                        over "Cart"
                        {
                            over "Body" (
                                instanceable = false
                            )
                            {
                                color3f[] primvars:displayColor = [(0.6382832, 0.010022826, 0.013411749)] (
                                    interpolation = "constant"
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "skinning"
    doc = "Forgery ignored on piece inbetween: the in-between ignored: a wide half-open slot on 'To' inside the round ring. This is what a viewer with that bug shows; the correct exhibit is ../skinning.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../skinning.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "skinning"
{
    over "Hero"
    {
        over "Performer"
        {
            over "Geom"
            {
                over "ArkitFace"
                {
                    over "Mesh"
                    {
                        over "jawOpen"
                        {
                            float inbetweens:Round = None
                        }
                    }
                }
            }
        }
    }
}


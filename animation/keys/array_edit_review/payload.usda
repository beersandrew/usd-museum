#usda 1.0
(
    defaultPrim = "array_edit_review"
    doc = "PR 603 / #600: spec answer key versus live OpenUSD and an explicitly incorrect order of operations. Generated by usd-tour museum/exhibits/animation.keys.array_edit_review/src/build.py (usd-tour 1d60c79); do not edit."
    endTimeCode = 121
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    subLayers = [
        @./parts/weak.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "array_edit_review" (
    customData = {
        dictionary museum = {
            string id = "animation.keys.array_edit_review"
            string issue = "https://github.com/aousd/core-spec-wg/issues/600"
            string look_for = "The teal marble stays still until frame 49 in SPEC and OPENUSD, but rises too soon in WRONG ORDER. The orange marble is pinned by the edit."
            string spec = "https://github.com/aousd/core-spec-wg/pull/603"
            string status = "Local review exhibit; not added to the museum tour."
            string title = "Combine first. Interpolate second."
            string version = "0.26.11"
        }
    }
    doc = "SPEC is independently authored resolved samples. OPENUSD is live positions array-edit resolution over parts/weak.usda. WRONG ORDER is an illustration, not an observed OpenUSD bug. Draft proposal, not an adopted Core rule."
    kind = "assembly"
)

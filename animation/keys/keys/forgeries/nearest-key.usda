#usda 1.0
(
    defaultPrim = "keys"
    doc = "Forgery nearest-key on piece token: tokens switch half way to the next key: the cart shows over a gap in the track. This is what a viewer with that bug shows; the correct exhibit is ../keys.usda. Generated by usd-tour museum/src/export.py (usd-tour 1d60c79); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../keys.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "keys"
{
    over "Stands"
    {
        over "Types"
        {
            over "Pieces"
            {
                over "Token"
                {
                    over "Ride"
                    {
                        over "Cart"
                        {
                            token visibility = "inherited"
                            token visibility.timeSamples = {
                                385: "invisible",
                                396.5: "inherited",
                                420: "invisible",
                                444: "inherited",
                            }
                        }
                    }
                }
            }
        }
    }
}


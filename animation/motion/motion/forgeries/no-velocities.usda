#usda 1.0
(
    defaultPrim = "motion"
    doc = "Forgery no-velocities on piece throw: velocities ignored: the ball never leaves the launcher; the lit hoop is empty. This is what a viewer with that bug shows; the correct exhibit is ../motion.usda. Generated by usd-tour museum/src/export.py (usd-tour ad590e4); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../motion.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "motion"
{
    over "Throw"
    {
        over "Ball"
        {
            vector3f[] accelerations = None
            vector3f[] velocities = None
        }
    }
}


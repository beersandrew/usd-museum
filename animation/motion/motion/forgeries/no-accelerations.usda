#usda 1.0
(
    defaultPrim = "motion"
    doc = "Forgery no-accelerations on piece throw: accelerations ignored: the ball flies straight along its launch line, above the first lit hoop. This is what a viewer with that bug shows; the correct exhibit is ../motion.usda. Generated by usd-tour museum/src/export.py (usd-tour 2a4f48f); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../motion.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "motion"
{
    over "Throw"
    {
        over "Ball"
        {
            vector3f[] accelerations = None
        }
    }
}


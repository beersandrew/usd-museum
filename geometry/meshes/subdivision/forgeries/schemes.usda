#usda 1.0
(
    defaultPrim = "subdivision"
    doc = "Forgery schemes on piece schemes: scheme ignored: three rocks faceted beside smooth twins. This is what a viewer with that bug shows; the correct exhibit is ../subdivision.usda. Generated by usd-tour museum/src/export.py (usd-tour d26eb77); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../subdivision.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "subdivision"
{
    over "Pieces"
    {
        over "CatmullClark"
        {
            over "Live"
            {
                over "Body"
                {
                    over "Rock"
                    {
                        uniform token subdivisionScheme = "none"
                    }
                }
            }
        }

        over "Loop"
        {
            over "Live"
            {
                over "Body"
                {
                    over "Rock"
                    {
                        uniform token subdivisionScheme = "none"
                    }
                }
            }
        }

        over "Bilinear"
        {
            over "Live"
            {
                over "Body"
                {
                    over "Rock"
                    {
                        uniform token subdivisionScheme = "none"
                    }
                }
            }
        }
    }
}


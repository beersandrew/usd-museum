#usda 1.0
(
    defaultPrim = "meshes"
    doc = "Forgery holes on piece holes: holeIndices ignored: a red window, no bulb. This is what a viewer with that bug shows; the correct exhibit is ../meshes.usda. Generated by usd-tour museum/src/export.py (usd-tour 01e0acf); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../meshes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "meshes"
{
    over "Pieces"
    {
        over "Holes"
        {
            over "Pot"
            {
                over "Mesh"
                {
                    int[] holeIndices = []
                }
            }
        }
    }
}


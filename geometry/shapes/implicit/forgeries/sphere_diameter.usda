#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery sphere_diameter on piece sphere: radius read as diameter: a small sphere in its ghost. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "Sphere"
        {
            over "Shape"
            {
                double radius = 0.105
            }
        }
    }
}


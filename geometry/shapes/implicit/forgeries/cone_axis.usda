#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery cone_axis on piece axis: axis X ignored: the cone stands up through its ghost. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour 3c1a3af); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "ConeX"
        {
            over "Shape"
            {
                uniform token axis = "Y"
            }
        }
    }
}


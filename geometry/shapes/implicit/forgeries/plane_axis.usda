#usda 1.0
(
    defaultPrim = "implicit"
    doc = "Forgery plane_axis on piece plane: axis ignored: the plane lies flat, its frame empty. This is what a viewer with that bug shows; the correct exhibit is ../implicit.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../implicit.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "implicit"
{
    over "Pieces"
    {
        over "Plane"
        {
            over "Shape"
            {
                uniform token axis = "Y"
            }
        }
    }
}


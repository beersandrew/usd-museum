#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery pinned on piece pinned: pinned ignored: the tendril short of both pegs. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour d2e9d73); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../curves.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "curves"
{
    over "Pieces"
    {
        over "Tendril"
        {
            over "Vine"
            {
                over "Curve"
                {
                    uniform token wrap = "nonperiodic"
                }
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery point_widths on piece point-widths: point widths ignored: four small discs in their rings. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour ad590e4); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../curves.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "curves"
{
    over "Pieces"
    {
        over "Pollen"
        {
            over "Pollen"
            {
                float[] widths = [0.03] (
                    interpolation = "constant"
                )
            }
        }
    }
}


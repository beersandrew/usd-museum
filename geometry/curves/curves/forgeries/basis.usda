#usda 1.0
(
    defaultPrim = "curves"
    doc = "Forgery basis on piece periodic: cubic basis ignored: the ring and tendril kinked off their guides. This is what a viewer with that bug shows; the correct exhibit is ../curves.usda. Generated by usd-tour museum/src/export.py (usd-tour 3f3d1fa); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../curves.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "curves"
{
    over "Pieces"
    {
        over "Ring"
        {
            over "Trellis"
            {
                over "Vine"
                {
                    uniform token type = "linear"
                }
            }
        }

        over "Tendril"
        {
            over "Vine"
            {
                over "Curve"
                {
                    uniform token type = "linear"
                }
            }
        }
    }
}


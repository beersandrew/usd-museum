#usda 1.0
(
    defaultPrim = "volumes"
    doc = "Exhibit geometry.volumes.volumes: OpenVDB volumes. Look for: two clouds fill their ink boxes and hide their red cards; the second grows during the hold. Generated by usd-tour museum/src/export.py (usd-tour eb01c2c); do not edit. See RULES.md."
    endTimeCode = 96
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "volumes" (
    prepend apiSchemas = ["AuthorshipAPI:claude", "AuthorshipAPI:build"]
    assetInfo = {
        asset identifier = @./volumes.usda@
        string name = "volumes"
    }
    customData = {
        dictionary museum = {
            string[] belt = ["19.Clouds"]
            string id = "geometry.volumes.volumes"
            string look_for = "two clouds fill their ink boxes and hide their red cards; the second grows during the hold"
            string[] spec = ["usdVol#volume", "usdVol#openvdbasset"]
            string title = "OpenVDB volumes"
            string wg = "geometry"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    uniform string authorship:build:created = "2026-11-12T00:01:00-08:00"
    uniform string[] authorship:build:creator = ["usd-tour museum/src/export.py"]
    uniform string authorship:build:description = "Written through OpenUSD's Python API by usd-tour's build and export scripts (written by Claude Opus 5.5)."
    uniform string authorship:build:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/algorithmicMedia"
    uniform string[] authorship:build:inputs = ["source", "usd-tour 135ffaf"]
    uniform string authorship:build:softwarePackage = "OpenUSD"
    uniform string authorship:build:softwareVersion = "26.11"
    uniform string authorship:build:usageTerms = "CC0-1.0"
    uniform string authorship:claude:created = "2026-11-12T00:01:00-08:00"
    uniform string[] authorship:claude:creator = ["Claude Opus 5.5 (Anthropic)"]
    uniform string authorship:claude:description = "Claude Opus 5.5, working in Claude Code, built every prim in this museum: it designed the exhibits and wrote the usd-tour scripts that author them."
    uniform string authorship:claude:digitalSourceType = "http://cv.iptc.org/newscodes/digitalsourcetype/trainedAlgorithmicMedia"
    uniform string[] authorship:claude:inputs = ["source", "usd-tour 135ffaf"]

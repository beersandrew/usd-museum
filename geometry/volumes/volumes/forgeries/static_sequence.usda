#usda 1.0
(
    defaultPrim = "volumes"
    doc = "Forgery static_sequence on piece sequence: field sequence not animated: a small cloud and the NOT GROWN card. This is what a viewer with that bug shows; the correct exhibit is ../volumes.usda. Generated by usd-tour museum/src/export.py (usd-tour ad590e4); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../volumes.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "volumes"
{
    over "Pieces"
    {
        over "Sequence"
        {
            over "Cloud"
            {
                over "Density"
                {
                    asset filePath = @../data/cloud_b.0001.vdb@
                }

                over "Emission"
                {
                    asset filePath = @../data/cloud_b.0001.vdb@
                }
            }
        }
    }
}


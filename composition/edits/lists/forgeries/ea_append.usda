#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery ea_append on piece explicit-append: the end item put first: Sphere, Cone, Prism (LO-16). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 4f5f6ff); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "explicit_append"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/explicit_append/Inst/Protos/Sphere>,
                    </lists/Cells/explicit_append/Inst/Protos/Cone>,
                    </lists/Cells/explicit_append/Inst/Protos/Prism>,
                ]
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery ne_merge on piece none-explicit: the plain list keeps the base: Cone, Prism, Sphere, Cube (LO-12). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour ad590e4); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "none_explicit"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/none_explicit/Inst/Protos/Cone>,
                    </lists/Cells/none_explicit/Inst/Protos/Prism>,
                    </lists/Cells/none_explicit/Inst/Protos/Sphere>,
                    </lists/Cells/none_explicit/Inst/Protos/Cube>,
                    </lists/Cells/none_explicit/Inst/Protos/Capsule>,
                ]
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "lists"
    doc = "Forgery dn_delete on piece delete-none: the remove does nothing: Cube, Cone, Prism, Sphere (LO-15). This is what a viewer with that bug shows; the correct exhibit is ../lists.usda. Generated by usd-tour museum/src/export.py (usd-tour 62d7ecc); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lists.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lists"
{
    over "Cells"
    {
        over "delete_none"
        {
            over "Inst"
            {
                custom rel prototypes = [
                    </lists/Cells/delete_none/Inst/Protos/Cube>,
                    </lists/Cells/delete_none/Inst/Protos/Cone>,
                    </lists/Cells/delete_none/Inst/Protos/Prism>,
                    </lists/Cells/delete_none/Inst/Protos/Sphere>,
                ]
            }
        }
    }
}


    def Scope "Marks"
    {
        def "Structure"
        {
            def Material "Name_Mat"
            {
                token outputs:surface.connect = </Exhibit/Marks/Structure/Name_Mat/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    color3f inputs:emissiveColor.connect = </Exhibit/Marks/Structure/Name_Mat/Tex.outputs:rgb>
                    float inputs:opacity.connect = </Exhibit/Marks/Structure/Name_Mat/Tex.outputs:a>
                    float inputs:opacityThreshold = 0.5
                    float inputs:roughness = 1
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                    token outputs:surface
                }

                def Shader "St"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    string inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/Exhibit_Marks_Structure_Name.png@
                    float4 inputs:scale = (1, 1, 1, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Exhibit/Marks/Structure/Name_Mat/St.outputs:result>
                    float outputs:a
                    float3 outputs:rgb
                }
            }


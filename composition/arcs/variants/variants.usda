#usda 1.0
(
    defaultPrim = "variants"
    doc = "Exhibit composition.arcs.variants: Variant selections and fallbacks. Look for: every band matches the swatch on its pedestal. Generated by usd-tour museum/src/export.py (usd-tour 4f5f6ff); do not edit. See RULES.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "variants" (
    assetInfo = {
        asset identifier = @./variants.usda@
        string name = "variants"
    }
    customData = {
        dictionary museum = {
            string[] belt = ["02.Variants"]
            string id = "composition.arcs.variants"
            string look_for = "every band matches the swatch on its pedestal"
            string[] spec = ["composition"]
            string title = "Variant selections and fallbacks"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    over "Pieces"
    {
        over "default" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/default"]
                    string[] features = ["COMP-VARIANTS", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["nodefault"]
                    string reference = "a stripes swatch"
                    string[] spec = ["composition#variants", "composition#computing-variant-selection"]
                }
            }
            doc = "the asset's own selection (stripes)"
        )
        {
        }

        over "stronger" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/stronger layer"]
                    string[] features = ["COMP-VARIANTS", "COMP-VARIANT-SELECTION-ORDER"]
                    string[] forgeries = ["weakwins"]
                    string reference = "a dots swatch"
                    string[] rules = ["STR-16"]
                    string[] spec = ["composition#computing-variant-selection"]
                }
            }
            doc = "this layer's selection (dots) beats the weaker sublayer's (redx)"
        )
        {
        }

        over "fallback" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/plugin fallback"]
                    string[] features = ["COMP-VARIANTS", "COMP-VARIANT-FALLBACK"]
                    string[] forgeries = ["nofallback"]
                    string reference = "a checks swatch"
                    string[] spec = ["composition#computing-variant-selection"]
                }
            }
            doc = "no selection anywhere: the plugin fallback (wrap = checks)"
        )
        {
        }

        over "nested" (
            customData = {
                dictionary museum = {
                    string[] belt = ["02.Variants/nested"]
                    string[] features = ["COMP-VARIANTS-NESTED", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["nonested"]
                    string reference = "a stripes swatch with gold edges"
                    string[] spec = ["composition#variants"]
                }
            }
            doc = "a variant set inside the stripes variant, selected gold"
        )
        {
        }
    }
}


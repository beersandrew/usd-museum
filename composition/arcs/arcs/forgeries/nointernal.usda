#usda 1.0
(
    defaultPrim = "arcs"
    doc = "Forgery nointernal on piece internal: the internal reference not followed: the handle slot is empty. This is what a viewer with that bug shows; the correct exhibit is ../arcs.usda. Generated by usd-tour museum/src/export.py (usd-tour 3f3d1fa); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../arcs.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "arcs"
{
    over "Pieces"
    {
        over "internal"
        {
            over "Case"
            {
                over "Handle"
                {
                    float purpose = None
                    float visibility = None

                    over "Grip" (
                        active = false
                    )
                    {
                    }
                }
            }
        }
    }
}


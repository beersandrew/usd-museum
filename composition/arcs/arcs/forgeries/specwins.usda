#usda 1.0
(
    defaultPrim = "arcs"
    doc = "Forgery specwins on piece specializes: specializes beats local: a red tag on the blue ledge. This is what a viewer with that bug shows; the correct exhibit is ../arcs.usda. Generated by usd-tour museum/src/export.py (usd-tour 206d905); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../arcs.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "arcs"
{
    over "Pieces"
    {
        over "specializes"
        {
            over "Case"
            {
                over "Tag"
                {
                    color3f[] primvars:displayColor = [(0.63075715, 0.000607054, 0.010960094)] (
                        interpolation = "constant"
                    )
                }
            }
        }
    }
}


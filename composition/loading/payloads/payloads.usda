#usda 1.0
(
    defaultPrim = "payloads"
    doc = "Exhibit composition.loading.payloads: Payloads. Look for: every ghost filled by a blue vase; the two red outlines stay empty. Generated by usd-tour museum/src/export.py (usd-tour 3f3d1fa); do not edit. See RULES.md."
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "payloads" (
    assetInfo = {
        asset identifier = @./payloads.usda@
        string name = "payloads"
    }
    customData = {
        dictionary museum = {
            string[] belt = ["04.Bays"]
            string id = "composition.loading.payloads"
            string look_for = "every ghost filled by a blue vase; the two red outlines stay empty"
            string[] spec = ["composition", "stage_population"]
            string title = "Payloads"
            string wg = "core"
        }
    }
    kind = "assembly"
    prepend payload = @./payload.usda@
)
{
    over "Pieces"
    {
        over "payload" (
            customData = {
                dictionary museum = {
                    string[] belt = ["04.Bays/payload"]
                    string[] features = ["COMP-PAYLOAD", "COMP-LOAD"]
                    string[] forgeries = ["unloaded"]
                    string reference = "the vase's ghost on the pedestal"
                    string[] spec = ["composition#payloads"]
                }
            }
            doc = "a payload to parts/crate.usda's default prim, loaded: the blue vase"
        )
        {
        }

        over "subroot" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-PAYLOAD"]
                    string[] forgeries = ["wholestore"]
                    string reference = "the vase's ghost; a red outline where Spare would stand"
                    string[] spec = ["composition#payloads", "composition#namespace-mapping-1"]
                }
            }
            doc = "a sub-root payload, parts/store.usda</Store/Keep>: Keep's vase only, not the store's Spare beside it"
        )
        {
        }

        over "internal" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-PAYLOAD"]
                    string[] forgeries = ["nointernal"]
                    string reference = "the vase's ghost"
                    string[] spec = ["composition#payloads"]
                }
            }
            doc = "an internal payload to the class prim </Exhibit/_Parts/Vase> in this layer"
        )
        {
        }

        over "nested" (
            customData = {
                dictionary museum = {
                    string[] features = ["COMP-PAYLOAD", "COMP-LOAD"]
                    string[] forgeries = ["nonested"]
                    string reference = "the ghost of the stand and of the vase on it"
                    string[] spec = ["composition#payloads", "stage_population"]
                }
            }
            doc = "a payload inside a payload: parts/outer.usda brings a blue stand and a Holder whose own payload brings the vase; two load points, both loaded with descendants"
        )
        {
        }

        over "variant" (
            customData = {
                dictionary museum = {
                    string[] belt = ["04.Bays/payload in a variant"]
                    string[] features = ["COMP-PAYLOAD", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["novariantpayload"]
                    string reference = "the vase's ghost"
                    string[] spec = ["composition#payloads", "composition#variants"]
                }
            }
            doc = "a referenced asset (parts/stock.usda) whose selected variant, stock = full, holds a payload to the crate"
        )
        {
        }

        over "unselected" (
            customData = {
                dictionary museum = {
                    string[] belt = ["04.Bays/unselected variant"]
                    string[] features = ["COMP-PAYLOAD", "COMP-LOAD", "COMP-ARCS-IN-VARIANTS"]
                    string[] forgeries = ["unselected"]
                    string reference = "a red outline that stays empty"
                    string[] spec = ["composition#payloads", "composition#variants"]
                }
            }
            doc = "the same asset with stock = empty selected here: the payload in the unselected variant contributes nothing and is not loadable"
        )
        {
        }
    }
}


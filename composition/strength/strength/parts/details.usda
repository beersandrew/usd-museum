#usda 1.0
(
    "composition.strength.strength: the order details, five fights on a bench, each Case's primvars:displayColor from its two opinions; plinths in the winner's colour. Referenced by exhibit.usda."
    defaultPrim = "Details"
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @./arcs/nest_a.usda@,
        @./arcs/nest_b.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "Details" (
    kind = "assembly"
)
{
    def Scope "Looks"
    {
        def Material "tier"
        {
            token outputs:surface.connect = </Details/Looks/tier/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.60382736, 0.58701634, 0.53823555)
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0.04, 0.04, 0.04)
                int inputs:useSpecularWorkflow = 1

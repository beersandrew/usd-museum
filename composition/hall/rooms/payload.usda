    def "Placards"
    {
        def Xform "arcs"
        {
            matrix4d xformOp:transform = ( (2.220446049250313e-16, 0, 1, 0), (0, 1, 0, 0), (-1, 0, 2.220446049250313e-16, 0), (-0.22, 0, 2.848203768235635, 1) )
            uniform token[] xformOpOrder = ["xformOp:transform"]

            def Material "Card_Mat"
            {
                token outputs:surface.connect = </Rooms/Placards/arcs/Card_Mat/Surface.outputs:surface>

                def Shader "Surface"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0, 0, 0)
                    color3f inputs:emissiveColor.connect = </Rooms/Placards/arcs/Card_Mat/Tex.outputs:rgb>
                    float inputs:opacity.connect = </Rooms/Placards/arcs/Card_Mat/Tex.outputs:a>
                    float inputs:opacityThreshold = 0.5
                    float inputs:roughness = 1
                    color3f inputs:specularColor = (0, 0, 0)
                    int inputs:useSpecularWorkflow = 1
                    token outputs:surface
                }

                def Shader "St"
                {
                    uniform token info:id = "UsdPrimvarReader_float2"
                    string inputs:varname = "st"
                    float2 outputs:result
                }

                def Shader "Tex"
                {
                    uniform token info:id = "UsdUVTexture"
                    asset inputs:file = @./textures/Rooms_Placards_arcs_Card.png@
                    float4 inputs:scale = (1, 1, 1, 1)
                    token inputs:sourceColorSpace = "sRGB"
                    float2 inputs:st.connect = </Rooms/Placards/arcs/Card_Mat/St.outputs:result>
                    float outputs:a
                    float3 outputs:rgb
                }
            }

            def Mesh "Card" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )

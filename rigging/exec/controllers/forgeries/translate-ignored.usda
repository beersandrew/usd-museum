#usda 1.0
(
    defaultPrim = "controllers"
    doc = "Forgery translate-ignored on piece arm: in:tx/ty ignored: the arm hinges at the plinth's middle, the bulb off its arc. This is what a viewer with that bug shows; the correct exhibit is ../controllers.usda. Generated by usd-tour museum/src/export.py (usd-tour 1d60c79); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../controllers.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "controllers"
{
    over "Pieces"
    {
        over "Arm"
        {
            over "Controller"
            {
                double in:tx = 0
                double in:ty = 0
            }
        }
    }
}


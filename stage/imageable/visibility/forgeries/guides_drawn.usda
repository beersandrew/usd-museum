#usda 1.0
(
    defaultPrim = "visibility"
    doc = "Forgery guides_drawn on piece purposes: guides drawn: a red halo in the zone above the proxy. This is what a viewer with that bug shows; the correct exhibit is ../visibility.usda. Generated by usd-tour museum/src/export.py (usd-tour 8cd916e); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../visibility.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "visibility"
{
    over "Pieces"
    {
        over "Statue"
        {
            over "Guide"
            {
                uniform token purpose = "default"
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "types"
    doc = "Forgery preference_last on piece preference: the preference list read from the end: a cube poking out of the ball ghost. This is what a viewer with that bug shows; the correct exhibit is ../types.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    fallbackPrimTypes = {
        token[] DeptBall = ["FacilityBall", "Sphere", "Cube"]
        token[] FancyLamp = ["Cylinder"]
    }
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../types.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "types"
{
    over "Pieces"
    {
        over "Preference"
        {
            over Cube "DeptBall"
            {
                double size = 2
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "fallbacks"
    doc = "Forgery radius_ignored on piece radius: the radius fallback not 1 (read as 0.5): a half-size ball clear of both posts and the bar. This is what a viewer with that bug shows; the correct exhibit is ../fallbacks.usda. Generated by usd-tour museum/src/export.py (usd-tour 8cd916e); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../fallbacks.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "fallbacks"
{
    over "Pieces"
    {
        over "Sphere"
        {
            over "Ball"
            {
                double radius = 0.5
            }
        }
    }
}


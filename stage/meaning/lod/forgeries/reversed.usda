#usda 1.0
(
    defaultPrim = "lod"
    doc = "Forgery reversed on piece cars: the index read from the far end: a red car on the blue band, a blue car on the red band. This is what a viewer with that bug shows; the correct exhibit is ../lod.usda. Generated by usd-tour museum/src/export.py (usd-tour ad590e4); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lod.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lod"
{
    over "Pieces"
    {
        over "Near"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "invisible"
                }

                over "Coarse"
                {
                    token visibility = "inherited"
                }
            }
        }

        over "Far"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "inherited"
                }

                over "Coarse"
                {
                    token visibility = "invisible"
                }
            }
        }
    }
}


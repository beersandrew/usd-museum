#usda 1.0
(
    defaultPrim = "lod"
    doc = "Forgery misread on piece cars: root transform ignored: every car measured from the exhibit origin, all three green (blue and red bands). This is what a viewer with that bug shows; the correct exhibit is ../lod.usda. Generated by usd-tour museum/src/export.py (usd-tour 8cd916e); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lod.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lod"
{
    over "Pieces"
    {
        over "Near"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "invisible"
                }

                over "Medium"
                {
                    token visibility = "inherited"
                }
            }
        }

        over "Far"
        {
            over "Car"
            {
                over "Medium"
                {
                    token visibility = "inherited"
                }

                over "Coarse"
                {
                    token visibility = "invisible"
                }
            }
        }
    }
}


#usda 1.0
(
    defaultPrim = "lod"
    doc = "Forgery physics_domain on piece cars: the physics heuristic read for imaging: a blue car on the green band, a green car on the red band. This is what a viewer with that bug shows; the correct exhibit is ../lod.usda. Generated by usd-tour museum/src/export.py (usd-tour 194a3c7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lod.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lod"
{
    over "Pieces"
    {
        over "Mid"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "inherited"
                }

                over "Medium"
                {
                    token visibility = "invisible"
                }
            }
        }

        over "Far"
        {
            over "Car"
            {
                over "Medium"
                {
                    token visibility = "inherited"
                }

                over "Coarse"
                {
                    token visibility = "invisible"
                }
            }
        }
    }
}


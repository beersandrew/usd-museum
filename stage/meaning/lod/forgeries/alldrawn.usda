#usda 1.0
(
    defaultPrim = "lod"
    doc = "Forgery alldrawn on piece cars: every LOD item drawn: three red boxes, on blue, green and red bands. This is what a viewer with that bug shows; the correct exhibit is ../lod.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../lod.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "lod"
{
    over "Pieces"
    {
        over "Near"
        {
            over "Car"
            {
                over "Medium"
                {
                    token visibility = "inherited"
                }

                over "Coarse"
                {
                    token visibility = "inherited"
                }
            }
        }

        over "Mid"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "inherited"
                }

                over "Coarse"
                {
                    token visibility = "inherited"
                }
            }
        }

        over "Far"
        {
            over "Car"
            {
                over "Fine"
                {
                    token visibility = "inherited"
                }

                over "Medium"
                {
                    token visibility = "inherited"
                }
            }
        }
    }
}


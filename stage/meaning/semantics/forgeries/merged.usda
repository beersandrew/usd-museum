#usda 1.0
(
    defaultPrim = "semantics"
    doc = "Forgery merged on piece taxonomies: taxonomies merged: each class chip shows the shape glyph and a material swatch side by side, each material chip a red dash. This is what a viewer with that bug shows; the correct exhibit is ../semantics.usda. Generated by usd-tour museum/src/export.py (usd-tour d2e9d73); do not edit. See RULES.md."

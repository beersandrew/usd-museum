#usda 1.0
(
    defaultPrim = "semantics"
    doc = "Forgery static on piece over time: time-varying contents label ignored: a brown hexagon band (over plus and orange chips) over the orange plus key at frame 60. This is what a viewer with that bug shows; the correct exhibit is ../semantics.usda. Generated by usd-tour museum/src/export.py (usd-tour 3c1a3af); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../semantics.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "semantics"
{
    over "Pieces"
    {
        over "Shelf"
        {
            over "Bin6"
            {
                token[] semantics:labels:contents = ["hexes"]
            }
        }
    }
}


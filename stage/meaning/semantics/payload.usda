#usda 1.0
(
    "USD Museum exhibit stage.meaning.semantics: labelled bins in two taxonomies (and labels over time); each card, drawn from UsdSemantics' labels, must match the printed key under it. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 216
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)


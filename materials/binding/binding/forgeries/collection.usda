#usda 1.0
(
    defaultPrim = "binding"
    doc = "Forgery collection on piece bowl: collection binding unsupported: grey fruit on the orange base. This is what a viewer with that bug shows; the correct exhibit is ../binding.usda. Generated by usd-tour museum/src/export.py (usd-tour 1c0b96b); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../binding.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "binding"
{
    over "Pieces"
    {
        over "bowl"
        {
            custom rel material:binding:collection:fruit = None
        }
    }
}


#usda 1.0
(
    "USD Museum exhibit materials.surfaces.preview: five shader balls, one UsdPreviewSurface input each, under their reference prints. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 1
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24

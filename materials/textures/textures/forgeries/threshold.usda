#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery threshold on piece leaf: opacityThreshold ignored: the leaf's full square. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour 57f972e); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "leaf"
        {
            over "Looks"
            {
                over "Leaf"
                {
                    over "Surface"
                    {
                        float inputs:opacity = None
                        float inputs:opacity.connect = None
                        float inputs:opacityThreshold = None
                    }
                }
            }
        }
    }
}


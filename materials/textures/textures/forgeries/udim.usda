#usda 1.0
(
    defaultPrim = "textures"
    doc = "Forgery udim on piece udim: <UDIM> not expanded: a grey wall. This is what a viewer with that bug shows; the correct exhibit is ../textures.usda. Generated by usd-tour museum/src/export.py (usd-tour a47e4d7); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../textures.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "textures"
{
    over "Pieces"
    {
        over "udim"
        {
            over "Looks"
            {
                over "Udim"
                {
                    over "Tex"
                    {
                        asset inputs:file = @./textures/udim.UDIM.png@
                    }
                }
            }
        }
    }
}


#usda 1.0
(
    "USD Museum exhibit physics.motion.machine: the garage machine as authored UsdPhysics, then its baked run, on one base. At rest (frames 1-95): colliders are guides (painted red here: drawn only if guides are drawn), physics materials carry red surfaces (drawn only if the physics binding is used for rendering), brass pins at the joint frames, targets at the centres of mass. From 96 the ghosts show; the run (unit frames 1-96, referenced 108 frames late) fills them at 195. Built by src/build.py."
    defaultPrim = "Exhibit"
    endTimeCode = 234
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)


#usda 1.0
(
    defaultPrim = "shaping"
    doc = "Forgery cone_ignored on piece narrow: cones ignored: both lamps flood the booth past their rings. This is what a viewer with that bug shows; the correct exhibit is ../shaping.usda. Generated by usd-tour museum/src/export.py (usd-tour 28915de); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../shaping.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "shaping"
{
    over "Pieces"
    {
        over "Narrow"
        {
            over "Light"
            {
                float inputs:shaping:cone:angle = 90
            }
        }

        over "Wide"
        {
            over "Light"
            {
                float inputs:shaping:cone:angle = 90
            }
        }
    }
}


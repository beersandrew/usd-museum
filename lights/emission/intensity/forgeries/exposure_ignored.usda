#usda 1.0
(
    defaultPrim = "intensity"
    doc = "Forgery exposure_ignored on piece exposure: exposure ignored: the +1 card as dark as the base, beside a 2x swatch. This is what a viewer with that bug shows; the correct exhibit is ../intensity.usda. Generated by usd-tour museum/src/export.py (usd-tour c9fc295); do not edit. See RULES.md."
    framesPerSecond = 24
    metersPerUnit = 1
    subLayers = [
        @../intensity.usda@
    ]
    timeCodesPerSecond = 24
    upAxis = "Y"
)

over "intensity"
{
    over "Pieces"
    {
        over "ExposurePlus1"
        {
            over "Light"
            {
                float inputs:exposure = 0
            }
        }
    }
}

